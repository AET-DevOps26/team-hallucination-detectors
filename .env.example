# VibeShield local environment — copy to `.env` and fill in real values.
# Consumed by docker-compose.yml. `.env` is gitignored; this template is not.

# --- OpenAI (openai.com) provider ---------------------------------------
# Required only if you select the "openai" provider in the UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LANGCHAIN_MODEL_NAME=gpt-4o-mini

# --- TUM Logos gateway (default provider) -------------------------------
LOGOS_API_KEY=
LOGOS_BASE_URL=https://logos.aet.cit.tum.de/v1
LOGOS_MODEL_NAME=openai/gpt-oss-120b
