# VibeShield — local development environment
# Copy to .env and fill in real values before running docker compose.
# Never commit .env — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=vibeshield

# ── Spring Boot services (api-service, auth-service) ─────────────────────────
SPRING_DATASOURCE_PASSWORD=vibeshield
APP_JWT_SECRET=dev-secret-change-me-minimum-32-chars-required

# ── GenAI / langchain-service ─────────────────────────────────────────────────
# OpenAI (openai.com) — required only if you select the "openai" provider in the UI
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
LANGCHAIN_MODEL_NAME=gpt-4o-mini

# TUM Logos gateway (default provider) — OpenAI-compatible, provided by the course
LOGOS_API_KEY=
LOGOS_BASE_URL=https://logos.aet.cit.tum.de/v1
LOGOS_MODEL_NAME=openai/gpt-oss-120b

# Self-hosted model (Ollama) — runs as the "ollama" service in docker-compose.
# The key is a dummy Ollama ignores; blank it to disable the "selfhosted" provider.
SELFHOSTED_API_KEY=ollama
SELFHOSTED_BASE_URL=http://ollama:11434/v1
SELFHOSTED_MODEL_NAME=llama3.2:3b

# RAG knowledge base for fix-prompt grounding (optional — additive, not required
# for the service to run; see docs/langchain.md#rag-knowledge-base). DATABASE_URL
# already defaults to the compose database service, so it usually doesn't need
# overriding here. EMBEDDING_API_KEY falls back to OPENAI_API_KEY if left blank.
# DATABASE_URL=postgresql+asyncpg://vibeshield:vibeshield@database:5432/vibeshield
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small