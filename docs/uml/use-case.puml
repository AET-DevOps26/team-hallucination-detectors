@startuml VibeShield-UseCase
' =====================================================================
'  VibeShield - Use Case Diagram
'  Scope: ONLY capabilities implemented on `main` (verified 2026-06-28).
'  Deferred features (code/repo scanning, active OWASP probing,
'  self-hosted/local LLM) are intentionally NOT shown.
'  Auth is the self-contained JWT auth-service (docs/auth.md).
' =====================================================================

left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 60
skinparam packageStyle rectangle

actor "Vibecoder\n(non-technical\nsite owner)" as User

rectangle "VibeShield" as VS {
  usecase "Register"               as UC_Reg
  usecase "Log in"                 as UC_Login
  usecase "Add a site"             as UC_Add
  usecase "Run a scan"             as UC_Scan
  usecase "View findings"          as UC_View
  usecase "Generate AI fix prompt" as UC_Fix
  usecase "View scan history"      as UC_Hist
}

' Supporting (secondary) actors are EXTERNAL SYSTEMS, not people:
' drawn as <<system>> boxes rather than the stick-figure actor icon.
rectangle "Target website\n(site being scanned)" <<system>> as Site
rectangle "Cloud LLM\n(OpenAI API)"               <<system>> as LLM

User --> UC_Reg
User --> UC_Login
User --> UC_Add
User --> UC_Scan
User --> UC_View
User --> UC_Hist
User --> UC_Fix

' A fix prompt is generated on demand from a finding the user is viewing.
UC_Fix ..> UC_View : <<extend>>

UC_Scan --> Site : "HTTP probes"
UC_Fix  --> LLM  : "prompt generation"

' Stack the use cases in workflow order (purely a layout hint).
UC_Reg  -[hidden]- UC_Login
UC_Login -[hidden]- UC_Add
UC_Add  -[hidden]- UC_Scan
UC_Scan -[hidden]- UC_View
UC_View -[hidden]- UC_Fix
UC_Fix  -[hidden]- UC_Hist

@enduml
