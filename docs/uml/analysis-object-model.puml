@startuml Analysis Object Model
!theme plain
skinparam classBackgroundColor #EEF4FF
skinparam defaultFontSize 12
skinparam classFontSize 13

title VibeShield — Analysis Object Model

' ── Auth Service ─────────────────────────────────────────────
package "Auth Service" #F1F8F1 {

  class User {
    - id: Long
    - email: String
    - password: String (BCrypt)
    + register()
    + login(): JWT
    + resetPassword()
  }

  class PasswordResetToken {
    - id: Long
    - userId: Long
    - token: String
    - expiresAt: Instant
    + isExpired(): boolean
  }

  class JwtService {
    + generateToken(user): String
    + validateToken(token): Claims
  }

  User "1" *-- "0..*" PasswordResetToken
  User ..> JwtService
}

' ── API Service ──────────────────────────────────────────────
package "API Service" #EEF4FF {

  class Website {
    - id: Long
    - ownerId: Long
    - url: String
    - name: String
    - createdAt: Instant
  }

  class Scan {
    - id: Long
    - websiteId: Long
    - status: ScanStatus
    - requestedChecks: List<ScanCheck>
    - crawlDepth: int
    - createdAt: Instant
    - startedAt: Instant
    - completedAt: Instant
    - errorMessage: String
    + markRunning()
    + markCompleted()
    + markFailed(reason)
  }

  class Finding {
    - id: Long
    - scanId: Long
    - checkType: ScanCheck
    - title: String
    - severity: Severity
    - affected: String
    - explanation: String
    - suggestedFix: String
    - status: FindingStatus
  }

  enum ScanStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
  }

  enum Severity {
    CRITICAL
    HIGH
    MEDIUM
    LOW
    INFO
  }

  enum FindingStatus {
    OPEN
    FIXED
    IGNORED
  }

  class ScanWorker {
    + processNextPendingScan()
  }

  class ReportService {
    + generateHtml(scanId): String
    + generatePdf(scanId): byte[]
    + buildExecutiveSummary(): ExecutiveSummary
  }

  class RescanService {
    + rescan(websiteId): Scan
    + compareScans(old, new): ScanComparison
  }

  Website "1" *-- "0..*" Scan : owns >
  Scan "1" *-- "0..*" Finding : produces >
  Scan --> ScanStatus
  Finding --> Severity
  Finding --> FindingStatus
  ScanWorker ..> Scan : transitions
  ReportService ..> Finding : reads
  RescanService ..> Scan : creates
}

' ── Scanner Service ──────────────────────────────────────────
package "Scanner Service" #FFF8E1 {

  interface SecurityCheck {
    + type(): ScanCheck
    + run(target, fetcher): List<ScannerFinding>
  }

  class HttpsCheck implements SecurityCheck
  class HeadersCheck implements SecurityCheck
  class SensitiveFilesCheck implements SecurityCheck

  class ScanExecutor {
    + execute(target, checks): List<ScannerFinding>
  }

  class SsrfGuard {
    + validate(uri): void
  }

  ScanExecutor "1" o-- "1..*" SecurityCheck : runs >
  ScanExecutor ..> SsrfGuard : validates with
}

' ── GenAI Service ────────────────────────────────────────────
package "GenAI Service" #FFF0F5 {

  class PromptChain {
    + generateFixPrompt(finding): String
    + selectModel(): LLM
  }

  class LLMRouter {
    - cloudModel: OpenAI
    - localModel: LLaMA / GPT4All
    + route(request): LLMResponse
  }

  PromptChain ..> LLMRouter : uses
}

' ── Cross-service relationships ──────────────────────────────
ScanWorker ..> ScanExecutor : delegates scan to
ScanWorker ..> PromptChain : generates prompts via
User "1" -- "0..*" Website : owns >

@enduml